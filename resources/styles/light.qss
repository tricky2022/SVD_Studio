/* SVD Studio Light Engineering Theme */
* {
    outline: none;
}
QMainWindow, QWidget {
    background: #f3f6fa;
    color: #243142;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 10pt;
}
QMenuBar {
    background: #ffffff;
    color: #344255;
    border-bottom: 1px solid #d9e1ea;
    spacing: 4px;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #e7f1fb;
    color: #145b91;
}
QMenu {
    background: #ffffff;
    border: 1px solid #cfd9e5;
    padding: 5px;
}
QMenu::item {
    padding: 7px 30px 7px 12px;
}
QToolBar {
    spacing: 5px;
    padding: 6px 8px;
    background: #ffffff;
    border: 0;
    border-bottom: 1px solid #d9e1ea;
}
QToolButton {
    min-height: 26px;
    padding: 3px 10px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #35475b;
}
QToolButton:hover {
    background: #eef5fc;
    border-color: #c4dbee;
    color: #155c91;
}
QToolButton:pressed {
    background: #dcecf9;
}
QFrame#workspaceHeader {
    background: #ffffff;
    border: 1px solid #d7e0ea;
    border-radius: 7px;
}
QLabel#brandMark {
    color: #ffffff;
    background: #1769a6;
    border-radius: 5px;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#workspaceTitle {
    color: #1e344b;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 2px;
}
QLabel#workspaceSubtitle {
    color: #7a8b9d;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#workspaceState {
    color: #7b6a3c;
    background: #fff7dd;
    border: 1px solid #f0dfaa;
    border-radius: 10px;
    padding: 4px 9px;
    font-size: 9px;
    font-weight: 700;
}
QLineEdit {
    min-width: 275px;
    min-height: 29px;
    padding: 2px 10px;
    background: #f7f9fc;
    border: 1px solid #cbd7e3;
    border-radius: 5px;
    color: #243142;
}
QLineEdit:focus {
    background: #ffffff;
    border: 1px solid #4e9bd0;
}
QFrame#navigationPanel, QFrame#editorPanel, QFrame#propertiesPanel {
    background: #ffffff;
    border: 1px solid #d7e0ea;
    border-radius: 7px;
}
QFrame#registerMapPlaceholder, QFrame#bitViewPlaceholder {
    background: #fbfcfe;
    border: 1px solid #e1e7ee;
    border-radius: 6px;
}
QLabel#navigationTitle, QLabel#editorTitle, QLabel#propertiesTitle {
    color: #6c7e91;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
}
QLabel#registerMapTitle, QLabel#bitViewTitle {
    color: #273c52;
    font-size: 11px;
    font-weight: 700;
}
QTreeView, QTableView, QTableWidget, QListWidget, QPlainTextEdit {
    background: #ffffff;
    alternate-background-color: #f7f9fc;
    border: 1px solid #d5dee8;
    gridline-color: #e4eaf0;
    selection-background-color: #dcecf9;
    selection-color: #123e61;
}
QTreeView {
    padding: 5px;
    show-decoration-selected: 1;
}
QTreeView::item {
    min-height: 25px;
    padding: 3px 5px;
    border-radius: 3px;
}
QTreeView::item:hover {
    background: #f0f6fc;
}
QTreeView::item:selected {
    background: #dcecf9;
    color: #145b91;
    font-weight: 600;
}
QHeaderView::section {
    background: #eef3f8;
    color: #5d7084;
    border: 0;
    border-right: 1px solid #d8e1ea;
    border-bottom: 1px solid #d8e1ea;
    padding: 6px 8px;
    font-weight: 700;
}
QTableWidget::item, QTableView::item, QListWidget::item {
    padding: 5px 7px;
}
QTableWidget::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background: #dcecf9;
    color: #123e61;
}
QSplitter::handle {
    background: #e1e8ef;
}
QSplitter::handle:hover {
    background: #8ab8da;
}
QTabWidget::pane {
    border: 1px solid #d5dee8;
    background: #ffffff;
}
QTabBar::tab {
    min-width: 78px;
    padding: 7px 14px;
    background: #f1f5f9;
    border: 1px solid #d5dee8;
    color: #6d7e90;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #145b91;
    font-weight: 700;
    border-bottom-color: #ffffff;
}
QStatusBar {
    color: #6b7e91;
    background: #ffffff;
    border-top: 1px solid #d9e1ea;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: #f3f6fa;
    width: 11px;
    height: 11px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #b9c9d8;
    border-radius: 5px;
    min-height: 22px;
}
QScrollBar::handle:hover {
    background: #8faec6;
}
QPushButton {
    min-height: 28px;
    padding: 4px 12px;
    border: 1px solid #cbd7e3;
    border-radius: 4px;
    background: #ffffff;
    color: #35475b;
}
QPushButton:hover {
    background: #eef5fc;
    border-color: #9cc3e3;
}
