/* Dark — generated from ui/palette.py design tokens.
   Do not edit by hand; change the tokens and regenerate. */
* { outline: none; }

QMainWindow, QWidget {
    background: #1e2430; color: #d7dde6;
    font-family: 'Segoe UI', 'Microsoft YaHei UI', sans-serif; font-size: 9pt;
}

QMainWindow { border: 1px solid #3a4354; }
QWidget#registerMapView, QWidget#problemsList, QWidget#outputText {
    background: #262d3b; font-family: Consolas, 'Cascadia Mono', monospace; font-size: 8.5pt;
}

QMenuBar { background: #262d3b; color: #8b94a4;
    border-bottom: 1px solid #3a4354; padding: 1px 4px; }
QMenuBar::item { padding: 4px 8px; }
QMenuBar::item:selected { background: #2c3444; color: #d7dde6; }
QMenu { background: #262d3b; border: 1px solid #3a4354; padding: 3px; }
QMenu::item { padding: 5px 28px 5px 9px; }
QMenu::item:selected { background: #3a4a66; color: #eef2f9; }
QMenu::separator { height: 1px; background: #3a4354; margin: 4px 8px; }

QToolBar { background: #262d3b; border: 0; border-bottom: 1px solid #3a4354;
    padding: 1px 4px; spacing: 1px; }
QToolBar::separator { width: 1px; background: #3a4354; margin: 3px 5px; }
QToolButton { min-height: 22px; padding: 1px 5px;
    border: 1px solid transparent; color: #8b94a4; }
QToolButton:hover { background: #2c3444; color: #d7dde6; }
QToolButton:pressed, QToolButton:checked { background: #3a4a66; border-color: #4b5568; color: #eef2f9; }
QToolButton:disabled { color: #6b7586; }

QLineEdit, QComboBox, QSpinBox { min-height: 24px; padding: 1px 8px;
    background: #262d3b; color: #d7dde6; border: 1px solid #3a4354; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #4b5568; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { background: #2c3444; border: 1px solid #6f9fd8; }
QComboBox::drop-down { border: 0; width: 16px; }
QComboBox QAbstractItemView { background: #262d3b; color: #d7dde6; selection-background-color: #3a4a66; selection-color: #eef2f9; }

QTreeView, QTableView, QListWidget, QTableWidget {
    background: #262d3b; color: #d7dde6;
    alternate-background-color: #2c3444;
    border: 1px solid #3a4354;
    selection-background-color: #3a4a66; selection-color: #eef2f9;
    show-decoration-selected: 0;
}
QSlider::groove:horizontal { background: #3a4354; height: 3px; }
QSlider::handle:horizontal { background: #6f9fd8; width: 12px; margin: -4px 0; }

QHeaderView::section { background: #2c3444; color: #8b94a4; border: 0;
    border-right: 1px solid #3a4354; border-bottom: 1px solid #3a4354;
    padding: 4px 7px; font-weight: 600; }
QTableWidget::item, QTableView::item, QListWidget::item { padding: 3px 6px; }
QTableWidget::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background: #3a4a66; color: #eef2f9; }

QSplitter::handle { background: #3a4354; width: 4px; }
QSplitter::handle:hover { background: #4c7bbf; }

QTabWidget::pane { border: 1px solid #3a4354; background: #262d3b; }
QTabBar::tab { min-width: 60px; padding: 3px 9px; background: #3a4354; color: #8b94a4; }
QTabBar::tab:selected { background: #262d3b; color: #d7dde6; font-weight: 600;
    border-top: 2px solid #6f9fd8; border-bottom-color: #262d3b; }

QPushButton { min-height: 24px; padding: 2px 10px;
    border: 1px solid #3a4354; border-radius: 3px; background: #262d3b; color: #d7dde6; }
QPushButton:hover { background: #2c3444; border-color: #4b5568; }
QPushButton:pressed { background: #3a4a66; }
QPushButton:default { background: #2f3d5c; color: #4c7bbf; border-color: #6f9fd8; }
QPushButton:disabled { color: #6b7586; background: #262d3b; }

QStatusBar { color: #8b94a4; background: #262d3b; border-top: 1px solid #3a4354; }
QScrollBar:vertical, QScrollBar:horizontal { background: #1e2430; width: 10px; height: 10px; }
QScrollBar::handle { background: #3a4354; border-radius: 4px; min-height: 22px; }
QScrollBar::handle:hover { background: #4b5568; }
QToolTip { background: #2c3444; color: #d7dde6; border: 1px solid #4b5568; padding: 3px 6px; }
QDockWidget::title { background: #2c3444; padding: 2px 8px; font-weight: 600; color: #8b94a4; }

/* NOTE: no QTreeView::branch rule on purpose. Styling ::branch without an
   explicit image suppresses the native expand/collapse indicator in Fusion,
   which is exactly how the tree lost its arrows. Items keep the native look. */
QTreeView::item:hover { background: #2c3444; }
QTreeView::item:selected:!active { background: #2c3444; color: #8b94a4; }
