/* Light — generated from ui/palette.py design tokens.
   Do not edit by hand; change the tokens and regenerate. */
* { outline: none; }

QMainWindow, QWidget {
    background: #ffffff; color: #2b3138;
    font-family: 'Segoe UI', 'Microsoft YaHei UI', sans-serif; font-size: 9pt;
}

QMainWindow { border: 1px solid #d8dbe1; }
QWidget#registerMapView, QWidget#problemsList, QWidget#outputText {
    background: #f6f7f9; font-family: Consolas, 'Cascadia Mono', monospace; font-size: 8.5pt;
}

QMenuBar { background: #f6f7f9; color: #6b7280;
    border-bottom: 1px solid #d8dbe1; padding: 1px 4px; }
QMenuBar::item { padding: 4px 8px; }
QMenuBar::item:selected { background: #f0f2f5; color: #2b3138; }
QMenu { background: #f6f7f9; border: 1px solid #d8dbe1; padding: 3px; }
QMenu::item { padding: 5px 28px 5px 9px; }
QMenu::item:selected { background: #dfe7f5; color: #2b3138; }
QMenu::separator { height: 1px; background: #d8dbe1; margin: 4px 8px; }

QToolBar { background: #f6f7f9; border: 0; border-bottom: 1px solid #d8dbe1;
    padding: 1px 4px; spacing: 1px; }
QToolBar::separator { width: 1px; background: #d8dbe1; margin: 3px 5px; }
QToolButton { min-height: 22px; padding: 1px 5px;
    border: 1px solid transparent; color: #6b7280; }
QToolButton:hover { background: #f0f2f5; color: #2b3138; }
QToolButton:pressed, QToolButton:checked { background: #dfe7f5; border-color: #c9cdd6; color: #2b3138; }
QToolButton:disabled { color: #9aa1ab; }

QLineEdit, QComboBox, QSpinBox { min-height: 24px; padding: 1px 8px;
    background: #f6f7f9; color: #2b3138; border: 1px solid #d8dbe1; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #c9cdd6; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { background: #f0f2f5; border: 1px solid #3f66b0; }
QComboBox::drop-down { border: 0; width: 16px; }
QComboBox QAbstractItemView { background: #f6f7f9; color: #2b3138; selection-background-color: #dfe7f5; selection-color: #2b3138; }

QTreeView, QTableView, QListWidget, QTableWidget {
    background: #f6f7f9; color: #2b3138;
    alternate-background-color: #f0f2f5;
    border: 1px solid #d8dbe1;
    selection-background-color: #dfe7f5; selection-color: #2b3138;
    show-decoration-selected: 0;
}
QSlider::groove:horizontal { background: #d8dbe1; height: 3px; }
QSlider::handle:horizontal { background: #3f66b0; width: 12px; margin: -4px 0; }

QHeaderView::section { background: #f0f2f5; color: #6b7280; border: 0;
    border-right: 1px solid #d8dbe1; border-bottom: 1px solid #d8dbe1;
    padding: 4px 7px; font-weight: 600; }
QTableWidget::item, QTableView::item, QListWidget::item { padding: 3px 6px; }
QTableWidget::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background: #dfe7f5; color: #2b3138; }

QSplitter::handle { background: #d8dbe1; width: 4px; }
QSplitter::handle:hover { background: #2f4d8f; }

QTabWidget::pane { border: 1px solid #d8dbe1; background: #f6f7f9; }
QTabBar::tab { min-width: 60px; padding: 3px 9px; background: #d8dbe1; color: #6b7280; }
QTabBar::tab:selected { background: #f6f7f9; color: #2b3138; font-weight: 600;
    border-top: 2px solid #3f66b0; border-bottom-color: #f6f7f9; }

QPushButton { min-height: 24px; padding: 2px 10px;
    border: 1px solid #d8dbe1; border-radius: 3px; background: #f6f7f9; color: #2b3138; }
QPushButton:hover { background: #f0f2f5; border-color: #c9cdd6; }
QPushButton:pressed { background: #dfe7f5; }
QPushButton:default { background: #e6ecf7; color: #2f4d8f; border-color: #3f66b0; }
QPushButton:disabled { color: #9aa1ab; background: #f6f7f9; }

QStatusBar { color: #6b7280; background: #f6f7f9; border-top: 1px solid #d8dbe1; }
QScrollBar:vertical, QScrollBar:horizontal { background: #ffffff; width: 10px; height: 10px; }
QScrollBar::handle { background: #d8dbe1; border-radius: 4px; min-height: 22px; }
QScrollBar::handle:hover { background: #c9cdd6; }
QToolTip { background: #f0f2f5; color: #2b3138; border: 1px solid #c9cdd6; padding: 3px 6px; }
QDockWidget::title { background: #f0f2f5; padding: 2px 8px; font-weight: 600; color: #6b7280; }

/* NOTE: no QTreeView::branch rule on purpose. Styling ::branch without an
   explicit image suppresses the native expand/collapse indicator in Fusion,
   which is exactly how the tree lost its arrows. Items keep the native look. */
QTreeView::item:hover { background: #f0f2f5; }
QTreeView::item:selected:!active { background: #f0f2f5; color: #6b7280; }
